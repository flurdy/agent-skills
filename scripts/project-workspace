#!/usr/bin/env python3
"""Create a portable project workspace without absorbing its repositories."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

REPOSITORY = Path(__file__).resolve().parents[1]
TEMPLATES = REPOSITORY / "templates" / "project-workspace"
MANAGED_DIRECTORIES = (
    "docs/prds",
    "docs/adrs",
    "docs/architecture",
    "docs/runbooks",
    "repos",
    "infrastructure",
)


class WorkspaceError(RuntimeError):
    """A safe, user-facing workspace creation failure."""


@dataclass(frozen=True)
class Workspace:
    name: str
    slug: str
    root: Path
    repository: Path | None

    @property
    def repository_link(self) -> Path | None:
        if self.repository is None:
            return None
        return self.root / "repos" / self.slug


def slugify(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    if not slug:
        raise WorkspaceError("project name must contain at least one letter or number")
    return slug


def nested(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
    except ValueError:
        return False
    return True


def workspace_from(arguments: argparse.Namespace) -> Workspace:
    if arguments.repo is None and arguments.name is None:
        raise WorkspaceError("provide a project name or --repo PATH")
    if arguments.repo is not None and arguments.name is not None:
        raise WorkspaceError("provide a project name or --repo PATH, not both")

    repository: Path | None = None
    if arguments.repo is not None:
        repository = arguments.repo.expanduser().resolve()
        if not repository.is_dir():
            raise WorkspaceError(f"repository does not exist: {repository}")
        if not (repository / ".git").exists():
            raise WorkspaceError(f"not a Git repository: {repository}")
        name = repository.name
    else:
        name = arguments.name.strip()
        if not name or "\n" in name or "\r" in name:
            raise WorkspaceError("project name must be a non-empty single line")

    slug = slugify(name)
    if arguments.output is not None:
        root = Path(os.path.abspath(arguments.output.expanduser()))
    elif repository is not None:
        root = repository.parent / f"{slug}-workspace"
    else:
        root = Path.cwd() / slug
    root = Path(os.path.abspath(root))

    physical_root = root.resolve()
    if repository is not None and (
        nested(physical_root, repository) or nested(repository, physical_root)
    ):
        raise WorkspaceError("workspace and repository must be separate directories")

    return Workspace(name=name, slug=slug, root=root, repository=repository)


def render_template(name: str, replacements: dict[str, str]) -> str:
    template = (TEMPLATES / name).read_text(encoding="utf-8")
    for marker, value in replacements.items():
        template = template.replace(f"{{{{{marker}}}}}", value)
    return template


def repository_summary(workspace: Workspace) -> str:
    if workspace.repository is None:
        return "_No repositories are registered yet._"
    return f"- `{workspace.slug}` — [`repos/{workspace.slug}`](repos/{workspace.slug}) (primary)"


def manifest(workspace: Workspace) -> str:
    repositories: list[dict[str, str]] = []
    if workspace.repository is not None:
        repositories.append(
            {
                "name": workspace.slug,
                "path": f"repos/{workspace.slug}",
                "role": "primary",
            }
        )
    data = {
        "version": 1,
        "name": workspace.name,
        "repositories": repositories,
        "infrastructure": [],
    }
    return json.dumps(data, indent=2) + "\n"


def managed_files(workspace: Workspace) -> dict[Path, str]:
    replacements = {
        "PROJECT_NAME": workspace.name,
        "REPOSITORIES": repository_summary(workspace),
    }
    files = {
        workspace.root / "README.md": render_template("README.md.tmpl", replacements),
        workspace.root / "AGENTS.md": render_template("AGENTS.md.tmpl", replacements),
        workspace.root / "Makefile": render_template("Makefile.tmpl", replacements),
        workspace.root / "workspace.json": manifest(workspace),
    }
    for directory in MANAGED_DIRECTORIES:
        files[workspace.root / directory / ".gitkeep"] = ""
    return files


def existing_text(path: Path) -> str | None:
    if path.is_symlink():
        raise WorkspaceError(f"managed file path is a symlink: {path}")
    if not path.exists():
        return None
    if not path.is_file():
        raise WorkspaceError(f"managed file path is not a file: {path}")
    return path.read_text(encoding="utf-8")


def managed_directory_paths(root: Path) -> list[Path]:
    paths: set[Path] = set()
    for directory in MANAGED_DIRECTORIES:
        path = root
        for part in Path(directory).parts:
            path /= part
            paths.add(path)
    return sorted(paths, key=lambda path: (len(path.parts), str(path)))


def git_is_valid(root: Path) -> bool:
    result = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"],
        capture_output=True,
        check=False,
        text=True,
    )
    return result.returncode == 0 and result.stdout.strip() == "true"


def preflight(workspace: Workspace, files: dict[Path, str], dry_run: bool) -> bool:
    if workspace.root.is_symlink():
        raise WorkspaceError(f"workspace root must not be a symlink: {workspace.root}")
    if workspace.root.exists() and not workspace.root.is_dir():
        raise WorkspaceError(f"workspace root is not a directory: {workspace.root}")

    for path in managed_directory_paths(workspace.root):
        if path.is_symlink():
            raise WorkspaceError(f"managed directory must not be a symlink: {path}")
        if path.exists() and not path.is_dir():
            raise WorkspaceError(f"managed directory path is not a directory: {path}")

    git_path = workspace.root / ".git"
    if git_path.is_symlink():
        raise WorkspaceError(f"workspace Git metadata must not be a symlink: {git_path}")
    if os.path.lexists(git_path) and not (workspace.root / "workspace.json").is_file():
        raise WorkspaceError(f"refusing to scaffold inside an existing Git repository: {workspace.root}")

    beads_path = workspace.root / ".beads"
    if beads_path.is_symlink():
        raise WorkspaceError(f"workspace Beads metadata must not be a symlink: {beads_path}")
    if beads_path.exists() and not beads_path.is_dir():
        raise WorkspaceError(f"workspace Beads metadata is not a directory: {beads_path}")

    conflicts = [
        path
        for path, expected in files.items()
        if (current := existing_text(path)) is not None and current != expected
    ]

    link = workspace.repository_link
    if link is not None and os.path.lexists(link):
        if not link.is_symlink() or link.resolve() != workspace.repository:
            conflicts.append(link)

    if conflicts:
        details = "\n".join(f"  - {path}" for path in conflicts)
        raise WorkspaceError(f"refusing to overwrite existing workspace content:\n{details}")

    if dry_run:
        return os.path.lexists(git_path)
    if shutil.which("git") is None:
        raise WorkspaceError("git is required to initialise or validate the workspace")
    if shutil.which("bd") is None:
        raise WorkspaceError("bd is required to initialise project-level tracking")
    return git_is_valid(workspace.root) if os.path.lexists(git_path) else False


def relative(path: Path, root: Path) -> str:
    try:
        return str(path.relative_to(root))
    except ValueError:
        return str(path)


def print_plan(
    workspace: Workspace, files: dict[Path, str], git_ready: bool
) -> None:
    print(f"Workspace: {workspace.root}")
    for directory in MANAGED_DIRECTORIES:
        path = workspace.root / directory
        print(f"{'KEEP' if path.is_dir() else 'CREATE'} directory {relative(path, workspace.root)}")
    for path, expected in files.items():
        current = existing_text(path)
        action = "UNCHANGED" if current == expected else "CREATE"
        print(f"{action} file {relative(path, workspace.root)}")
    if workspace.repository_link is not None:
        action = "UNCHANGED" if os.path.lexists(workspace.repository_link) else "CREATE"
        print(
            f"{action} link {relative(workspace.repository_link, workspace.root)}"
            f" -> {workspace.repository}"
        )
    if not git_ready:
        print("RUN git init -b main")
    print("RUN bd init --init-if-missing --non-interactive --skip-agents")


def create_workspace(workspace: Workspace, dry_run: bool) -> None:
    files = managed_files(workspace)
    git_ready = preflight(workspace, files, dry_run)
    if dry_run:
        print_plan(workspace, files, git_ready)
        return

    workspace.root.mkdir(parents=True, exist_ok=True)
    manifest_path = workspace.root / "workspace.json"
    if not manifest_path.exists():
        manifest_path.write_text(files[manifest_path], encoding="utf-8")

    if not git_ready:
        subprocess.run(["git", "init", "-b", "main"], cwd=workspace.root, check=True)
    subprocess.run(
        ["bd", "init", "--init-if-missing", "--non-interactive", "--skip-agents"],
        cwd=workspace.root,
        check=True,
    )

    for directory in MANAGED_DIRECTORIES:
        (workspace.root / directory).mkdir(parents=True, exist_ok=True)
    for path, content in files.items():
        if not path.exists():
            path.write_text(content, encoding="utf-8")

    if workspace.repository_link is not None and not os.path.lexists(workspace.repository_link):
        target = os.path.relpath(workspace.repository, workspace.repository_link.parent)
        workspace.repository_link.symlink_to(target, target_is_directory=True)

    print(f"Initialised workspace: {workspace.root}")


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(prog="project-workspace")
    subcommands = command.add_subparsers(dest="command", required=True)
    init = subcommands.add_parser("init", help="initialise a project workspace")
    init.add_argument("name", nargs="?", help="new project name")
    init.add_argument("--repo", type=Path, help="existing Git repository to link")
    init.add_argument("--output", type=Path, help="workspace root directory")
    init.add_argument("--dry-run", action="store_true", help="preview without writing")
    return command


def main() -> int:
    arguments = parser().parse_args()
    try:
        workspace = workspace_from(arguments)
        create_workspace(workspace, arguments.dry_run)
    except (WorkspaceError, OSError, UnicodeError, subprocess.CalledProcessError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
