#!/usr/bin/env bash
# next-bd: Show ready beads ranked by priority, with labels, filtered against blocked.
# Usage: next-bd [OPTIONS]
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: next-bd [OPTIONS]

Options:
  --list         Include complete non-selectable in-progress, blocked, deferred tables,
                 plus a P4 backlog table when fewer than 3 beads are ready
  --backlog      Always include the P4 backlog table with --list
  --in-progress  Include a compact in-progress summary (ignored with --list)
  --avoid-busy   Exclude ready beads whose labels are busy in their store (tracker-only)
  --safe         Show scope/occupancy-unavailable queues without certifying safety
  --safe-json    Read-only candidate/scope packet for the optional in-process Pi helper
  --json         Print ranked candidates as JSON
  --type=TYPE    Include only candidates of the given issue type
  --help         Show this help and exit
EOF
}

FULL_LIST=false
SHOW_BACKLOG=false
BACKLOG_THRESHOLD=3
SHOW_IN_PROGRESS=false
AVOID_BUSY=false
JSON_OUTPUT=false
SAFE_OUTPUT=false
SAFE_JSON=false
TYPE_FILTER=""
for arg in "$@"; do
  case "$arg" in
    --list)        FULL_LIST=true ;;
    --backlog)     SHOW_BACKLOG=true ;;
    --in-progress) SHOW_IN_PROGRESS=true ;;
    --avoid-busy)  AVOID_BUSY=true ;;
    --json)        JSON_OUTPUT=true ;;
    --safe)        SAFE_OUTPUT=true ;;
    --safe-json)   SAFE_OUTPUT=true; SAFE_JSON=true ;;
    --type=*)      TYPE_FILTER=${arg#--type=} ;;
    --help)        usage; exit 0 ;;
  esac
done

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
collector_args=()
if "$SAFE_OUTPUT"; then
  collector_args+=(--source-scope)
  AVOID_BUSY=false
fi
payload=$("$SCRIPT_DIR/collect.py" "${collector_args[@]}")

if "$JSON_OUTPUT"; then
  jq -r '.diagnostics[] | "next-bd: \(.)"' <<< "$payload" >&2
fi

jq -r \
  --arg full_list "$FULL_LIST" \
  --arg show_ip "$SHOW_IN_PROGRESS" \
  --arg show_backlog "$SHOW_BACKLOG" \
  --argjson backlog_threshold "$BACKLOG_THRESHOLD" \
  --arg avoid_busy "$AVOID_BUSY" \
  --arg json_output "$JSON_OUTPUT" \
  --arg safe_output "$SAFE_OUTPUT" \
  --arg safe_json "$SAFE_JSON" \
  --arg type_filter "$TYPE_FILTER" '
  def cell: (. // "—") | tostring | gsub("[\u0000-\u001f\u007f-\u009f]+"; " ") | gsub("\\|"; "&#124;");
  def row: "| " + (map(cell) | join(" | ")) + " |";
  def overlap_ids($claims):
    . as $candidate |
    [$claims[] | select((.repository // "") == ($candidate.repository // "")) |
      select(any(.labels[]?; . as $label | ($candidate.labels // []) | index($label))) | .id];
  def service_overlap($claims):
    . as $candidate |
    [$claims[] | select((.repository // "") == ($candidate.repository // "")) |
      {id, services: [(.services // [])[] | select(. as $service | ($candidate.services // []) | index($service))]} |
      select(.services | length > 0)];
  def issue_fields($workspace):
    (if $workspace then [.repository] else [] end) +
    [.id, "P\(.priority)", .issue_type, (.labels // [] | if length == 0 then "-" else join(", ") end), .title];
  def safe_table($title; $rows; $workspace; $numbered; $overlap):
    ((if $numbered then ["#"] else [] end) + (if $workspace then ["Repo"] else [] end) +
      ["ID", "Pri", "Type", "Labels", "Title", "Lease check"] +
      (if $overlap then ["Shared service"] else [] end)) as $headers |
    "## \($title) (\($rows | length) beads)\n\n" +
    (if $overlap then "May collide with claimed work; labels only, not lease evidence.\n\n" else "" end) +
    (if ($rows | length) == 0 then "_No candidates without a shared in-progress service._" else
      ($headers | row) + "\n" + ($headers | map("---") | row) + "\n" +
      ($rows | to_entries | map(
        (if $numbered then [.key + 1] else [] end) + (.value | issue_fields($workspace)) +
        [.value.lease_check] +
        (if $overlap then ["\(.value.shared_services | join(", ")) (\(.value.tracker_overlap | join(", ")))"] else [] end) | row
      ) | join("\n")) end);
  def blocker_context:
    if (.blocked_by // [] | length) > 0 then .blocked_by | join(", ")
    elif (.blocked_by_count // 0) > 0 then "\(.blocked_by_count) blockers"
    else "—" end;
  def non_ready_table($title; $status; $rows; $workspace; $extra):
    ((if $workspace then ["Repo"] else [] end) +
      ["ID", "Pri", "Type", "Labels", "Title"] +
      (if $extra == "" then [] else [$extra] end)) as $headers |
    "\n\n## \($title) (\($rows | length) \($status))\n" +
    (if $title | ascii_downcase | contains("in progress") then "\nTracker claims; session activity unverified.\n" else "" end) +
    (if ($rows | length) == 0 then "\n_None._" else
      "\n" + ($headers | row) + "\n" + ($headers | map("---") | row) + "\n" +
      ($rows | sort_by(.priority, .created_at, (.repository // ""), .id) | map(
        ((if $workspace then [.repository] else [] end) +
          [.id, (if .priority == null then "—" else "P\(.priority)" end),
           .issue_type, (.labels // [] | if length == 0 then "-" else join(", ") end), .title] +
          (if $extra == "Blocked by" then [blocker_context]
           elif $extra == "Defer until" then [.defer_until]
           elif $extra == "Updated" then [(.updated_at // .created_at // "—")[0:10]]
           else [] end)) | row
      ) | join("\n"))
    end);

  . as $payload |
  ($payload.workspace) as $workspace |
  ($payload.blocked | map("\(.repository // "")\u0000\(.id)")) as $blocked_keys |
  ($payload.in_progress) as $in_progress |
  ($payload.diagnostics) as $diagnostics |

  ($payload.ready |
    map(select(
      . as $candidate |
      "\($candidate.repository // "")\u0000\($candidate.id)" as $candidate_key |
      $blocked_keys | index($candidate_key) | not
    ))
  ) as $unblocked |
  ($unblocked | map(select(.priority == 4))) as $backlog |

  ($unblocked |
    map(select(.priority >= 0 and .priority <= 3)) |
    if $type_filter != "" then
      map(select(.issue_type == $type_filter))
    else . end |
    if $avoid_busy == "true" then
      map(select((overlap_ids($in_progress) | length) == 0))
    else . end |
    map(. + {
      rank: (
        if .priority == 0 then 1
        elif .priority == 1 and .issue_type == "bug" then 2
        elif .priority == 2 and .issue_type == "bug" then 3
        elif .priority == 1 and (.issue_type == "feature" or .issue_type == "task") then 4
        elif .priority == 1 and .issue_type == "epic" then 5
        elif .priority == 2 and (.issue_type == "feature" or .issue_type == "task") then 6
        elif .priority == 3 and (.issue_type == "bug" or .issue_type == "feature" or .issue_type == "task") then 7
        elif .priority == 2 and .issue_type == "epic" then 8
        elif .priority == 3 and .issue_type == "epic" then 9
        else 10
        end
      )
    }) |
    sort_by(.rank, .created_at, (.repository // ""), .id)
  ) as $ranked |

  if $safe_json == "true" then
    {version: 1, workspace: $workspace, candidates: $ranked,
     in_progress: $in_progress, blocked: $payload.blocked, deferred: $payload.deferred,
     diagnostics: $diagnostics}
  elif $safe_output == "true" then
    ($ranked | map(service_overlap($in_progress) as $overlap | . + {
      tracker_overlap: ($overlap | map(.id)),
      shared_services: ($overlap | map(.services[]) | unique),
      lease_check: (if .source_scope.state == "unknown" then "unknown"
        elif .source_scope.state == "partial" then "partial"
        elif .source_scope.state == "invalid" then "invalid"
        else "n/a" end)
    })) as $safe_rows |
    ($safe_rows | map(select(.tracker_overlap | length == 0))) as $review |
    ($safe_rows | map(select(.tracker_overlap | length > 0))) as $overlaps |
    safe_table("Ready to review"; $review; $workspace; true; false) +
    "\n\nLease check: 0 free, \($review | length) not checked; no in-process Pi observer. unknown = no source_scope declaration; partial = incomplete scope; n/a = observer unavailable. Not checked does not mean occupied. No lease was acquired." +
    (if ($overlaps | length) > 0 then
      "\n\n" + safe_table("Held back — same service as in-progress work"; $overlaps; $workspace; false; true)
    else "" end) +
    (if ($in_progress | length) > 0 then non_ready_table("Claimed — in progress"; "beads; not selectable"; $in_progress; $workspace; "") else "" end) +
    (if ($payload.blocked | length) > 0 then non_ready_table("Waiting — blocked"; "beads; not selectable"; $payload.blocked; $workspace; "Blocked by") else "" end) +
    (if ($payload.deferred | length) > 0 then non_ready_table("Later — deferred"; "beads; not selectable"; $payload.deferred; $workspace; "Defer until") else "" end) +
    (if ($diagnostics | length) > 0 then "\n\nSource diagnostics:\n" + ($diagnostics | map("- " + cell) | join("\n")) else "" end) +
    "\n\nNumbers are for review, not safe claims. Selector = \(if $workspace then "Repo:ID" else "local:ID" end). Only a fresh eligible recheck permits a safe claim."
  elif $json_output == "true" then
    $ranked
  else
    "## Ready to Work (\($ranked | length) beads)\n" +
    (if $workspace then
      "| # | Repo | ID | Pri | Type | Labels | Title |\n" +
      "|---|---|---|---|---|---|---|\n"
    else
      "| # | ID | Pri | Type | Labels | Title |\n" +
      "|---|---|---|---|---|---|\n"
    end) +
    ($ranked | to_entries | map(
      if $workspace then
        "| \(.key + 1) | \(.value.repository) | \(.value.id) | P\(.value.priority) | \(.value.issue_type) | \(.value.labels // [] | if length == 0 then "-" else join(", ") end) | \(.value.title) |"
      else
        "| \(.key + 1) | \(.value.id) | P\(.value.priority) | \(.value.issue_type) | \(.value.labels // [] | if length == 0 then "-" else join(", ") end) | \(.value.title) |"
      end
    ) | join("\n")) +
    if $full_list == "true" then
      non_ready_table("In Progress"; "beads; not selectable"; $in_progress; $workspace; "") +
      non_ready_table("Blocked"; "beads; not selectable"; $payload.blocked; $workspace; "Blocked by") +
      non_ready_table("Deferred"; "beads; not selectable"; $payload.deferred; $workspace; "Defer until") +
      if $show_backlog == "true" or
         (($ranked | length) < $backlog_threshold and ($backlog | length) > 0) then
        non_ready_table("Backlog"; "P4 beads; not auto-pickable, start by ID"; $backlog; $workspace; "Updated")
      else "" end
    elif $show_ip == "true" and ($in_progress | length) > 0 then
      "\n\nTracker status: in progress (session activity unverified):\n" +
      ($in_progress | map(
        if $workspace then
          "- [\(.repository)] `\(.id)` (P\(.priority) \(.issue_type)) \"\(.title)\""
        else
          "- `\(.id)` (P\(.priority) \(.issue_type)) \"\(.title)\""
        end
      ) | join("\n"))
    else "" end +
    if ($diagnostics | length) > 0 then
      "\n\nSource diagnostics:\n" +
      ($diagnostics | map("- " + .) | join("\n"))
    else "" end
  end
' <<< "$payload"
