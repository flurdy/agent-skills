SHELL := /usr/bin/env bash

.PHONY: help status doctor

help:
	@echo "make status    # show active and ready cross-project work"
	@echo "make doctor    # validate the workspace structure"

status:
	@command -v bd >/dev/null 2>&1 || { echo "ERROR: bd is required" >&2; exit 127; }
	@bd list --status=in_progress
	@bd list --ready

doctor:
	@test -e .git || { echo "ERROR: workspace Git metadata is missing" >&2; exit 1; }
	@test -d .beads || { echo "ERROR: workspace Beads metadata is missing" >&2; exit 1; }
	@test -f workspace.json || { echo "ERROR: workspace.json is missing" >&2; exit 1; }
	@python3 -m json.tool workspace.json >/dev/null
	@python3 -c 'import json, pathlib; root = pathlib.Path("."); data = json.loads((root / "workspace.json").read_text()); assert data.get("version") == 1 and isinstance(data.get("name"), str); entries = data.get("repositories", []) + data.get("infrastructure", []); assert isinstance(data.get("repositories"), list) and isinstance(data.get("infrastructure"), list); assert all(isinstance(entry, dict) and isinstance(entry.get("path"), str) for entry in entries); missing = [entry["path"] for entry in entries if not (root / entry["path"]).exists()]; assert not missing, "missing workspace paths: " + ", ".join(missing)'
	@test -f AGENTS.md -a -f README.md || { echo "ERROR: workspace guidance is incomplete" >&2; exit 1; }
	@test -d docs/prds -a -d docs/adrs -a -d docs/architecture -a -d docs/runbooks || { echo "ERROR: workspace docs are incomplete" >&2; exit 1; }
	@test -d repos -a -d infrastructure || { echo "ERROR: workspace links are incomplete" >&2; exit 1; }
	@echo "Workspace: PASS"
